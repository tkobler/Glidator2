    function runTest(test as String or Number) as Boolean {
        var id = test;
        if (test instanceof Lang.String) {
            id = getIndexOf(test);
        }

        assertMessage(id >= 0, "Could not find '" + test + "'");
        var result = false;
        if (id < 30) {
            result = self.evaluate_test_entries_0_to_30(id, logger);
        }

        else if (id < 60) {
            result = self.evaluate_test_entries_30_to_60(id, logger);
        }

        else if (id < 90) {
            result = self.evaluate_test_entries_60_to_90(id, logger);
        }

        else if (id < 120) {
            result = self.evaluate_test_entries_90_to_120(id, logger);
        }

        else if (id < 150) {
            result = self.evaluate_test_entries_120_to_150(id, logger);
        }

        else if (id < 180) {
            result = self.evaluate_test_entries_150_to_180(id, logger);
        }

        else if (id < 210) {
            result = self.evaluate_test_entries_180_to_210(id, logger);
        }

        else if (id < 223) {
            result = self.evaluate_test_entries_210_to_223(id, logger);
        }

        if (result instanceof Boolean) {
            return result;
        }

        return false;
    }
}